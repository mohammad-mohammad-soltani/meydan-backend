COMPOSE_PROJECT_NAME=meydan-backend
WORDPRESS_PORT=8080
DB_NAME=meydan
DB_USER=meydan
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-me
REDIS_PASSWORD=change-redis-me
# InnoDB buffer pool: 50-60% of the RAM the database may use (e.g. 1G on a 4 GB host, 6G on 16 GB).
DB_BUFFER_POOL=1G
# 1 = reload PHP files on change (local dev). Production keeps 0.
OPCACHE_VALIDATE=1
WP_URL=http://localhost:8080
WP_TITLE=Meydan Backend
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-admin-me
WP_ADMIN_EMAIL=admin@example.com
WP_DEBUG=1
WP_ENVIRONMENT_TYPE=local
# Local-only OTP. In production leave empty and configure an SMS provider via constants/secrets.
MEYDAN_DEV_OTP_CODE=482193
# Optional local-only challenge lifetime in seconds (default 120). Handy when the
# pinned code is read out-of-band instead of from an SMS. Ignored in production.
MEYDAN_DEV_OTP_TTL=
# Optional production SMS webhook; do NOT commit secrets.
MEYDAN_SMS_ENDPOINT=
MEYDAN_SMS_TOKEN=
# EitaaUserBot integration. Use the same long random secret in both repositories.
MEYDAN_EITAA_SYNC_SECRET=
EITAA_SERVICE_URL=http://eitaa-api:3000
MEYDAN_BALE_SYNC_SECRET=
BALE_SERVICE_URL=http://bale-api:8000
MEYDAN_DOCKER_NETWORK=meydan_internal
# Pushe Web Push (https://console.pushe.co). The API token is a secret.
# MEYDAN_FRONTEND_URL is used to turn relative notification deep-links into HTTPS URLs.
MEYDAN_PUSHE_APP_ID=
MEYDAN_PUSHE_TOKEN=
MEYDAN_FRONTEND_URL=
MEDIA_STORAGE=local
MEDIA_STORAGE_PREFIX=local
MEDIA_PUBLIC_URL=
MEDIA_MAX_FILE_SIZE=104857600
MEDIA_ALLOWED_MIME_TYPES=
MEDIA_STORAGE_SHA256_VERIFY=true
MEDIA_STORAGE_SHA256_MAX_BYTES=268435456
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Bale bot is configured in wp-admin (میدان → تنظیمات → پیکربندی ربات بله);
# the token and chat_id are stored as WordPress options, not here.
# This optional constant only overrides the stored token for deployments.
MEYDAN_BALE_BOT_TOKEN=
# External Soketi/Pusher-compatible transport. APP_SECRET must only exist in runtime secrets.
MEYDAN_SOKETI_APP_ID=naghsh-e4bb4dbbaa0ac5a621376177435d9390
MEYDAN_SOKETI_APP_KEY=naghsh-b5a7e6394b1c637cfee7eb2d7762a156
MEYDAN_SOKETI_APP_SECRET=
MEYDAN_SOKETI_HOST=naghshman.ir
MEYDAN_SOKETI_PORT=6001
MEYDAN_SOKETI_SCHEME=http
MEYDAN_SOKETI_PUBLIC_HOST=naghshman.ir
MEYDAN_SOKETI_PUBLIC_PORT=6001
MEYDAN_SOKETI_PUBLIC_SCHEME=http
